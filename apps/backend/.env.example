# ──────────────────────────────────────────────────────────────
# SVIT Backend — Environment Variables
# Copy to .env and fill in real values before running locally.
# All keys listed here must also be set in Railway dashboard.
# ──────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
# Railway auto-provides this when you add a Postgres plugin.
DATABASE_URL=postgresql://user:password@localhost:5432/svit

# ── Auth ──────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-min-32-chars-long-access
JWT_REFRESH_SECRET=change-me-min-32-chars-long-refresh

# ── App ───────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
# Public URL of this backend (used for webhooks/callbacks)
API_BASE_URL=https://your-backend.railway.app
# Public URL of the mobile/web frontend (used in emails, redirects)
APP_URL=https://your-frontend.app

# ── Admin ────────────────────────────────────────────────────
ADMIN_SECRET=change-me-strong-admin-secret

# ── AI ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Payments: YooKassa ───────────────────────────────────────
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://your-app.app/payment/return

# ── Payments: Stripe ─────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Payments: NOWPayments (crypto) ───────────────────────────
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=false

# ── Payments: Generic webhook secret ─────────────────────────
WEBHOOK_SECRET=

# ── Flights: Duffel ──────────────────────────────────────────
DUFFEL_API_KEY=

# ── Flights + Hotels: Travelpayouts ─────────────────────────
# One key works for both Aviasales (flights) and Hotellook (hotels).
# Register free at: https://travelpayouts.com → Dashboard → API
# Docs: https://support.travelpayouts.com/hc/en-us/articles/360004731452
TRAVELPAYOUTS_API_KEY=

# ── Flights: Aviasales (legacy — use TRAVELPAYOUTS_API_KEY instead) ──
# Kept for backward compatibility with aviasales.service.ts
AVIASALES_TOKEN=
AVIASALES_MARKER=

# ── Auth: Google OAuth ───────────────────────────────────────
GOOGLE_CLIENT_ID=

# ── Email: SMTP ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@svit.app

# ── Monitoring ───────────────────────────────────────────────
SENTRY_DSN=
