DATABASE_URL=postgresql://user:password@localhost:5432/travel_ai
JWT_ACCESS_SECRET=your-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-long
ANTHROPIC_API_KEY=your-anthropic-api-key
PORT=3000
NODE_ENV=development

# Admin panel secret — change before deploying to production
ADMIN_SECRET=admin_secret_change_me

# YooKassa (payment gateway) - https://yookassa.ru
# Leave blank to use mock mode (no real payments)
# YooKassa test credentials (sandbox):
YOOKASSA_SHOP_ID=381764
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=http://localhost:3000/payment/return

# Duffel API (international flights) - https://duffel.com
DUFFEL_API_KEY=

# Aviasales Partner API (CIS routes) - https://www.travelpayouts.com
AVIASALES_TOKEN=

# Aviasales search marker (affiliate)
AVIASALES_MARKER=

# Amadeus Hotel + Flight API (free sandbox) — https://developers.amadeus.com
# 1. Register at https://developers.amadeus.com
# 2. Create an app in "Self-Service" → get Client ID and Client Secret
# 3. Sandbox is free; switch AMADEUS_BASE_URL to https://api.amadeus.com for production
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com
