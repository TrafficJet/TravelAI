# ─────────────────────────────────────────────────────────────────────────────
# travel-ai backend — production environment variables
#
# Copy this file to .env.production and fill in every value before deploying.
# NEVER commit .env.production to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Node ──────────────────────────────────────────────────────────────────────
NODE_ENV=production

# Port the Fastify server listens on inside the container.
# Railway / Render inject their own PORT automatically; set to 3000 here
# so local docker-compose.prod.yml works without changes.
PORT=3000

# ── Database ───────────────────────────────────────────────────────────────────
# Full PostgreSQL connection string.
# When using docker-compose.prod.yml the host must be the compose service name
# (postgres), NOT localhost.
# Example: postgresql://travel_user:STRONG_PASSWORD@postgres:5432/travel_ai
DATABASE_URL=

# ── Authentication ─────────────────────────────────────────────────────────────
# Secrets used to sign JWT access and refresh tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Minimum 32 characters. Use different values for each secret.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── Anthropic (Claude AI) ──────────────────────────────────────────────────────
# API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ── Duffel (Flights / Hotels API) ─────────────────────────────────────────────
# API key from https://app.duffel.com/
# Use a LIVE key in production, a TEST key in staging.
DUFFEL_API_KEY=

# ── Optional: Postgres credentials (used by docker-compose.prod.yml only) ──────
# These are read by the postgres service in docker-compose.prod.yml.
# They must match the credentials embedded in DATABASE_URL above.
POSTGRES_USER=travel_user
POSTGRES_PASSWORD=
POSTGRES_DB=travel_ai
