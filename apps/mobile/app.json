{
  "expo": {
    "name": "TravelAI",
    "slug": "travel-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "travelai",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#060B18",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#060B18"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.travelai.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Для поиска отелей рядом с вами",
        "NSCameraUsageDescription": "Для фото профиля и сканирования документов (паспорт, права)",
        "NSUserNotificationUsageDescription": "Уведомления о статусе бронирований",
        "NSPhotoLibraryUsageDescription": "Для фото профиля и выбора документа из галереи"
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#060B18"
      },
      "package": "com.travelai.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#ffffff",
          "sounds": [],
          "androidMode": "default"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Для поиска отелей рядом с вами"
        }
      ],
      "@sentry/react-native",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "$API_URL",
      "sentryDsn": "",
      "eas": {
        "projectId": "placeholder-replace-after-eas-init"
      }
    }
  }
}
