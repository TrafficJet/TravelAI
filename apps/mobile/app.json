{
  "expo": {
    "name": "SVIT",
    "slug": "svit",
    "owner": "forza22",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "svit",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#060B18",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A1A2E"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.getsvit.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Для поиска отелей рядом с вами",
        "NSCameraUsageDescription": "Для фото профиля и сканирования документов (паспорт, права)",
        "NSUserNotificationUsageDescription": "Уведомления о статусе бронирований",
        "NSPhotoLibraryUsageDescription": "Для фото профиля и выбора документа из галереи"
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A1A2E"
      },
      "package": "com.getsvit.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#ffffff",
          "sounds": [],
          "androidMode": "default"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Для поиска отелей рядом с вами"
        }
      ],
      "@sentry/react-native",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Для фото профиля и выбора документа из галереи",
          "cameraPermission": "Для фото профиля и сканирования документов (паспорт, права)"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "$API_URL",
      "sentryDsn": "https://203439eb6d8b88caeda852db8bba5183@o4511415643078656.ingest.de.sentry.io/4511415732535376",
      "router": {},
      "eas": {
        "projectId": "ec47f236-645f-45af-8860-f352c09c2224"
      }
    }
  }
}
