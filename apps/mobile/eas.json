{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios": { "simulator": true },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:3000/api",
        "EXPO_PUBLIC_WS_URL": "ws://localhost:3000"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios": {
        "simulator": false,
        "distribution": "internal"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://travel-ai-backend-production-90a0.up.railway.app/api",
        "EXPO_PUBLIC_WS_URL": "wss://travel-ai-backend-production-90a0.up.railway.app",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "distribution": "store",
      "android": { "buildType": "app-bundle" },
      "ios": {
        "simulator": false,
        "distribution": "store",
        "image": "macos-sequoia-15.6-xcode-26.2"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://travel-ai-backend-production-90a0.up.railway.app/api",
        "EXPO_PUBLIC_WS_URL": "wss://travel-ai-backend-production-90a0.up.railway.app",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "SENTRY_ALLOW_FAILURE": "true"
      }
    },
    "production-ios": {
      "extends": "production",
      "distribution": "store",
      "ios": {
        "enterpriseProvisioning": "universal"
      },
      "env": {
        "APP_ENV": "production"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "turedo28@gmail.com",
        "ascAppId": "6773616118",
        "appleTeamId": "82WFY83V93"
      },
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal"
      }
    }
  }
}
